<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <!-- זיהוי נפילה צריך חיישן תאוצה; SOS בהחזקה עובד גם בלעדיו -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- רטט: התקדמות ההחזקה, חלון הביטול, "הכל בסדר?" אחרי נפילה -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- שירות חזית לדגימת החיישנים (רק כשזיהוי הנפילה מופעל בהגדרות השעון) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- תנאי מוקדם של אנדרואיד 14 לשירות חזית מסוג health (אחת מ-BODY_SENSORS / ACTIVITY_RECOGNITION / HIGH_SAMPLING_RATE_SENSORS).
         זו הרשאה רגילה (בלי חלון בקשה). הדגימה בפועל היא 50Hz - לא דגימה מהירה. לא מבקשים BODY_SENSORS (דופק) - לא בשימוש. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- רק אם אין במכשיר חיישן תאוצה "מעורר" (wake-up): המעבד נשאר ער בזמן הניטור, אחרת דגימות הולכות לאיבוד בשינה -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- מסך "הכל בסדר?" מעל פני השעון אחרי נפילה -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- הפעלה מחדש של זיהוי הנפילה אחרי אתחול השעון (אם מופעל בהגדרות) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- לא עצמאית: בלי הטלפון (וחשבון LifeGuard בטלפון) השעון לא יכול לשלוח SOS לשרת -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FallAlertActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity="org.lifeguard.wear.fall"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".FallMonitorService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- אישור + סטטוס אמיתי מהטלפון (Wearable Data Layer) -->
        <service
            android:name=".WatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/lifeguard/sos_" />
            </intent-filter>
        </service>

        <!-- "אני בסדר" / "צריך/ה עזרה" ישירות מההתראה (כשאין הרשאת מסך מלא) -->
        <receiver android:name=".FallActionReceiver" android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Tile: קיצור דרך למסך ה-SOS (ההפעלה עצמה תמיד בהחזקה של 2 שנ' במסך - לא בהקשה אחת על ה-Tile) -->
        <service
            android:name=".SosTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/ic_launcher_fg" />
        </service>
    </application>
</manifest>
