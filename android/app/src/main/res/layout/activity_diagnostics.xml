<?xml version="1.0" encoding="utf-8"?>
<!-- Readiness check: summary card, then one grouped card with a row per check (built in DiagnosticsActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/lg_bg" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/lg_page_padding" android:paddingEnd="@dimen/lg_page_padding"
        android:paddingTop="8dp" android:paddingBottom="32dp">

        <LinearLayout style="@style/LifeGuard.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView
                android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LifeGuard.Title2" android:accessibilityLiveRegion="polite" />
            <TextView
                android:id="@+id/checkedAt" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.LifeGuard.Footnote" />
            <Button
                android:id="@+id/refresh" style="@style/Widget.LifeGuard.Button.Tonal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/diag_refresh" />
        </LinearLayout>

        <TextView
            style="@style/LifeGuard.SectionHeader"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/diag_section_checks" />
        <LinearLayout
            android:id="@+id/list" style="@style/LifeGuard.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="4dp" android:paddingBottom="4dp" />
    </LinearLayout>
</ScrollView>
