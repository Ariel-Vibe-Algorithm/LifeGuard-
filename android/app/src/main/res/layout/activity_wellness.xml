<?xml version="1.0" encoding="utf-8"?>
<!--
  "Are you OK?" (full screen, lock screen). Calm warm surface (lg_warning_tint, light/dark), one huge "I'm OK".
  In a silent ride the activity repaints it neutral (plain background, grey buttons, routine wording).
  Ids are used by WellnessCheckActivity - keep them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
    android:paddingTop="24dp" android:paddingBottom="24dp" android:gravity="center_horizontal"
    android:background="@color/lg_warning_tint">

    <TextView
        android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="48dp" android:gravity="center" android:text="@string/wellness_title"
        android:textAppearance="@style/TextAppearance.LifeGuard.LargeTitle" android:textSize="40sp"
        android:textColor="@color/lg_label" android:accessibilityHeading="true" />
    <TextView
        android:id="@+id/reason" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center"
        android:textAppearance="@style/TextAppearance.LifeGuard.Title3" />
    <TextView
        android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:gravity="center"
        android:textAppearance="@style/TextAppearance.LifeGuard.Headline" android:textColor="@color/lg_label" android:textStyle="bold"
        android:accessibilityLiveRegion="polite" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <Button
        android:id="@+id/okBtn" style="@style/Widget.LifeGuard.Button.Success"
        android:layout_width="match_parent" android:layout_height="96dp"
        android:text="@string/wellness_ok" android:textSize="26sp" app:cornerRadius="@dimen/lg_radius_card" />
    <Button
        android:id="@+id/helpBtn" style="@style/Widget.LifeGuard.Button.Sos"
        android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="12dp"
        android:text="@string/wellness_help" android:textSize="20sp" app:cornerRadius="@dimen/lg_radius_card" />
</LinearLayout>
