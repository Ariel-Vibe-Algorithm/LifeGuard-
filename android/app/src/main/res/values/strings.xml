    <!-- תיעוד מקומי (ראיות) -->
    <string name="evidence_title">תיעוד מקומי</string>
    <string name="evidence_explain">לכל קריאת חירום נשמר במכשיר יומן מוצפן (מיקומים, זיהויי תנועה, שליחה/SMS, תגובות שהתקבלו, הודעות ששלחת, ושמע אם הופעל). כל רשומה מכילה hash של הקודמת - שינוי או מחיקה מתגלים באימות. צפייה וייצוא דורשים את נעילת המסך ונרשמים ביומן.</string>
