<?xml version="1.0" encoding="utf-8"?>
<!-- text field: 12dp corners, accent focus ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_surface" />
            <corners android:radius="@dimen/lg_radius_control" />
            <stroke android:width="2dp" android:color="@color/lg_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lg_surface" />
            <corners android:radius="@dimen/lg_radius_control" />
            <stroke android:width="1dp" android:color="@color/lg_separator" />
        </shape>
    </item>
</selector>
