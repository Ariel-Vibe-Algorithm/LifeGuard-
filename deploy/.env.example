# העתק ל-deploy/.env ומלא. לעולם לא להעלות את .env ל-git.

# הדומיין שמצביע (רשומת A) לכתובת ה-IP של השרת
LIFEGUARD_DOMAIN=lifeguard.example.com

# מפתח הצפנה למידע רפואי/טלפונים/VAPID - 32 בתים ב-base64. ליצירה:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# לשמור גם במקום בטוח מחוץ לשרת: בלי המפתח אי אפשר לפענח את הנתונים המוצפנים.
LIFEGUARD_DATA_KEY=

# טוקן לנתיבי הניהול (אישור מתנדבים). ליצירה: python -c "import secrets;print(secrets.token_urlsafe(32))"
LIFEGUARD_ADMIN_TOKEN=

LIFEGUARD_ACK_TIMEOUT_SECONDS=120

# אופציונלי - SMS (גיבוי לאנשי קשר, אימות טלפון, שליחת קודי הזמנה). בלי אלה: "לא מוגדר".
LIFEGUARD_TWILIO_ACCOUNT_SID=
LIFEGUARD_TWILIO_AUTH_TOKEN=
# מספר שולח (+972...) או Messaging Service SID (MG...)
LIFEGUARD_TWILIO_FROM=
# שירות Twilio Verify (VA...) לאימות מספרי טלפון
LIFEGUARD_TWILIO_VERIFY_SID=

# זמן הגעה בהליכה למתנדבים (אופציונלי): רק שרת OSRM עצמי - ראו DEPLOY_HE.md.
# לעולם לא שירות ניתוב ציבורי: הוא היה מקבל את מיקום האדם שבמצוקה.
LIFEGUARD_OSRM_URL=
